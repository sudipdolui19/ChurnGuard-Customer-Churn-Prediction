display(df.head())


# ============================================================
# 3. BASIC DATA UNDERSTANDING
# ============================================================

print("\nColumn Names:")
print(df.columns)

print("\nDataset Information:")
print(df.info())

print("\nStatistical Summary:")
display(df.describe())

print("\nFirst 5 Rows:")
display(df.head())

print("\nLast 5 Rows:")
